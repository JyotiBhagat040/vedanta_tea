# Tea Auction Backend - Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=production
PORT=5000

# PostgreSQL (local on same EC2 instance)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teadb
DB_USER=teauser
DB_PASSWORD=your_strong_password_here

# AI Suggestion (choose one)
# Option 1: Ollama (local, fully free)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Option 2: Hugging Face (free tier, 30k tokens/month)
# AI_PROVIDER=huggingface
# HF_API_KEY=your_hf_api_key_here

# File upload limits
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
